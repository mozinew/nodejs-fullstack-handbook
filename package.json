{
  "name": "nodejs-fullstack-handbook",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "docs:dev": "vitepress dev docs --host 127.0.0.1",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs --host 127.0.0.1",
    "test:solutions": "node --test solutions/**/*.test.mjs projects/**/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:structure": "node scripts/check-structure.mjs",
    "check:coverage": "node scripts/check-project-coverage.mjs",
    "check": "npm run check:structure && npm run check:coverage && npm run typecheck && npm run test:solutions && npm run docs:build"
  },
  "devDependencies": {
    "@types/node": "22.18.1",
    "typescript": "5.9.2",
    "vitepress": "1.6.4"
  }
}
